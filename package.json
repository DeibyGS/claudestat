{
  "name": "@statforge/claudestat",
  "version": "1.19.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Observability layer for Claude Code — live token tracking, cost analytics, quota guard, loop detection, and usage dashboard. The htop for Claude Code.",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "claude-monitoring",
    "token-tracker",
    "cost-tracker",
    "ai-observability",
    "claude-dashboard",
    "quota-guard",
    "rate-limit",
    "ai-agent",
    "llm-cost",
    "token-usage",
    "claude-hooks",
    "ai-productivity",
    "terminal-dashboard",
    "developer-tools",
    "cli",
    "monitoring",
    "analytics",
    "claude-pro",
    "claude-max",
    "ai-coding",
    "agentic-workflow",
    "observability",
    "opencode",
    "mcp",
    "mcp-server",
    "session-tracker",
    "context-window",
    "burn-rate",
    "ai-tools",
    "llm-observability",
    "library",
    "typescript-sdk"
  ],
  "homepage": "https://github.com/DeibyGS/claudestat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeibyGS/claudestat.git"
  },
  "bugs": {
    "url": "https://github.com/DeibyGS/claudestat/issues"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/DeibyGS"
  },
  "files": [
    "dist/",
    "hooks/",
    "dashboard/dist/",
    "docs/LIBRARY.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "require": "./dist/lib.js",
      "import": "./dist/lib.js"
    },
    "./advanced": {
      "types": "./dist/lib.d.ts",
      "require": "./dist/lib.js",
      "import": "./dist/lib.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "require": "./dist/mcp-server.js",
      "import": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "claudestat": "dist/index.js",
    "claudestat-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc && npm run build:dashboard",
    "build:dashboard": "cd dashboard && npm install && npm run build:only",
    "build:dashboard:only": "cd dashboard && npm run build:only",
    "build:bun": "bun run scripts/build-binary.ts",
    "build:bun:all": "bun run scripts/build-binary.ts --all",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "dev:full": "tsx src/index.ts start & sleep 1 && cd dashboard && npm run dev",
    "start": "node dist/index.js",
    "test": "node --require tsx/cjs tests/index.ts",
    "test:unit": "node --require tsx/cjs tests/unit-index.ts",
    "test:integration": "node --require tsx/cjs tests/integration-index.ts",
    "test:fast": "node --require tsx/cjs tests/unit-index.ts && node --require tsx/cjs tests/integration-index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --strict"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
